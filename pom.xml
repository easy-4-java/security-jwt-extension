    <groupId>io.github.easy4j</groupId>
    <artifactId>spring-security-jwt</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <url>https://github.com/easy-4-java/${project.artifactId}</url>
    <version>3.0.x.20260630-SNAPSHOT</version>
    <packaging>jar</packaging>
    <description>JWT authentication and authorization utilities for Spring Security</description>
    <!-- 开源协议采用 Apache 2.0 协议 -->
    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>
    <!-- 源码仓库（SCM）信息 -->
    <scm>
        <connection>scm:git:https://github.com/easy-4-java/${project.artifactId}.git</connection>
        <developerConnection>scm:git:https://github.com/easy-4-java/${project.artifactId}.git</developerConnection>
        <url>https://github.com/easy-4-java/${project.artifactId}</url>
        <tag>${project.artifactId}</tag>
    </scm>
    <!-- 开发者信息 -->
    <developers>
        <developer>
            <name>Loong Wan</name>
            <email>hiwepy@gmail.com</email>
            <url>https://github.com/loong10k</url>
            <roles>
                <role>developer</role>
            </roles>
